{
  "editor": {
    "fill_column": 70,
    "tab_width": 4
  },
  "terminal": {
    "shell": null,
    "shell_args": [],
    "term": "xterm-256color",
    "scrollback_lines": 10000,
    "backend": "daemon",
    "replay_bytes": 2097152,
    "socket": null,
    "daemon_idle_exit": 60,
    "escape_keys": ["C-x", "M-x", "C-c"]
  },
  "session": {
    "restore_session": true,
    "state_dir": null
  },
  "font": {
