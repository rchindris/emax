      "C-u": "universal-argument",
      "M--": "negative-argument",
      "C--": "negative-argument",
      "C-M--": "negative-argument",
      "M-0": "digit-argument", "M-1": "digit-argument", "M-2": "digit-argument", "M-3": "digit-argument", "M-4": "digit-argument",
      "M-5": "digit-argument", "M-6": "digit-argument", "M-7": "digit-argument", "M-8": "digit-argument", "M-9": "digit-argument",
      "C-0": "digit-argument", "C-1": "digit-argument", "C-2": "digit-argument", "C-3": "digit-argument", "C-4": "digit-argument",
      "C-5": "digit-argument", "C-6": "digit-argument", "C-7": "digit-argument", "C-8": "digit-argument", "C-9": "digit-argument",
