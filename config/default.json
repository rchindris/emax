      "ESC": "keyboard-quit",

      "C-k": "kill-line",
      "C-S-DEL": "kill-whole-line",
      "C-w": "kill-region",
      "s-x": "kill-region",
      "M-w": "kill-ring-save",
      "s-c": "kill-ring-save",
      "M-d": "kill-word",
      "C-<delete>": "kill-word",
      "M-DEL": "backward-kill-word",
      "C-DEL": "backward-kill-word",
      "M-k": "kill-sentence",
      "C-x DEL": "backward-kill-sentence",
      "C-M-k": "kill-sexp",
      "C-M-DEL": "backward-kill-sexp",
      "M-z": "zap-to-char",
      "C-y": "yank",
      "s-v": "yank",
      "M-y": "yank-pop",

      "C-d": "delete-char",
      "<delete>": "delete-char",
      "DEL": "delete-backward-char",
      "M-\\": "delete-horizontal-space",
      "M-SPC": "just-one-space",
      "M-^": "delete-indentation",
      "C-x C-o": "delete-blank-lines",

      "RET": "newline",
      "C-j": "electric-newline-and-maybe-indent",
      "C-o": "open-line",
      "TAB": "indent-for-tab-command",
      "C-x TAB": "indent-rigidly",
      "C-q": "quoted-insert",

      "C-t": "transpose-chars",
      "M-t": "transpose-words",
      "C-x C-t": "transpose-lines",
      "C-M-t": "transpose-sexps",
      "M-u": "upcase-word",
      "M-l": "downcase-word",
      "M-c": "capitalize-word",
      "C-x C-u": "upcase-region",
      "C-x C-l": "downcase-region",

      "M-q": "fill-paragraph",
      "C-x f": "set-fill-column",

      "C-/": "undo",
      "C-_": "undo",
      "C-x u": "undo",
      "s-z": "undo",
      "C-?": "undo-redo",
      "C-M-_": "undo-redo",
      "S-s-z": "undo-redo",

      "C->": "mc/mark-next-like-this",
      "C-<": "mc/mark-previous-like-this",
      "C-c C-<": "mc/mark-all-like-this",
      "C-c C->": "mc/skip-to-next-like-this",
      "C-c C-.": "mc/unmark-next-like-this",
      "C-S-c C-S-c": "mc/edit-lines",
      "s-d": "mc/mark-next-like-this",

      "C-s": "swiper",
      "s-f": "swiper",
      "C-r": "swiper-backward",

      "C-x b": "switch-to-buffer",
      "C-x C-b": "list-buffers",
      "C-x <left>": "previous-buffer",
      "C-x <right>": "next-buffer",
      "C-x k": "kill-buffer",

      "C-x C-s": "save-buffer",
      "s-s": "save-buffer",
      "C-x C-c": "save-buffers-kill-terminal",
      "s-q": "save-buffers-kill-terminal",
      "M-x": "execute-extended-command",

      "C-u": "universal-argument",
      "M--": "negative-argument",
      "C--": "negative-argument",
      "C-M--": "negative-argument",
      "M-0": "digit-argument", "M-1": "digit-argument", "M-2": "digit-argument", "M-3": "digit-argument", "M-4": "digit-argument",
      "M-5": "digit-argument", "M-6": "digit-argument", "M-7": "digit-argument", "M-8": "digit-argument", "M-9": "digit-argument",
      "C-0": "digit-argument", "C-1": "digit-argument", "C-2": "digit-argument", "C-3": "digit-argument", "C-4": "digit-argument",
      "C-5": "digit-argument", "C-6": "digit-argument", "C-7": "digit-argument", "C-8": "digit-argument", "C-9": "digit-argument",
      "C-M-0": "digit-argument", "C-M-1": "digit-argument", "C-M-2": "digit-argument", "C-M-3": "digit-argument", "C-M-4": "digit-argument",
      "C-M-5": "digit-argument", "C-M-6": "digit-argument", "C-M-7": "digit-argument", "C-M-8": "digit-argument", "C-M-9": "digit-argument"
    },

    "picker": {
      "C-g": "picker-quit",
      "ESC": "picker-quit",
      "RET": "picker-accept",
      "C-j": "picker-accept-input",
      "M-RET": "picker-accept-input",
      "C-n": "picker-next",
      "<down>": "picker-next",
      "TAB": "picker-next",
      "C-p": "picker-previous",
      "<up>": "picker-previous",
      "S-TAB": "picker-previous",
      "C-v": "picker-page-down",
      "<next>": "picker-page-down",
      "M-v": "picker-page-up",
      "<prior>": "picker-page-up",
      "M-<": "picker-first",
      "M->": "picker-last",
      "DEL": "picker-delete-char",
      "M-DEL": "picker-delete-word",
      "C-w": "picker-delete-word",
      "C-k": "picker-kill-buffer"
    },

    "search": {
      "C-g": "search-quit",
      "ESC": "search-quit",
      "RET": "search-accept",
      "C-s": "search-next-or-history",
      "s-f": "search-next-or-history",
      "s-g": "search-next-or-history",
      "C-r": "search-previous-or-history",
      "S-s-g": "search-previous-or-history",
      "C-n": "search-next",
      "<down>": "search-next",
      "TAB": "search-next",
      "C-p": "search-previous",
      "<up>": "search-previous",
      "S-TAB": "search-previous",
      "C-v": "search-page-down",
      "<next>": "search-page-down",
      "M-v": "search-page-up",
      "<prior>": "search-page-up",
      "M-<": "search-first",
      "M->": "search-last",
      "DEL": "search-delete-char",
      "M-DEL": "search-delete-word",
      "C-w": "search-delete-word",
      "C-u": "search-clear",
      "M-n": "search-insert-symbol"
