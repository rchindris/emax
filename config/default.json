      "C-x h": "mark-whole-buffer",
      "s-a": "mark-whole-buffer",
      "M-@": "mark-word",
      "M-h": "mark-paragraph",
      "C-M-SPC": "mark-sexp",
      "C-M-@": "mark-sexp",
