      "TAB": "indent-for-tab-command",
      "C-x TAB": "indent-rigidly",
      "C-q": "quoted-insert",

      "C-t": "transpose-chars",
      "M-t": "transpose-words",
      "C-x C-t": "transpose-lines",
      "C-M-t": "transpose-sexps",
      "M-u": "upcase-word",
      "M-l": "downcase-word",
      "M-c": "capitalize-word",
      "C-x C-u": "upcase-region",
      "C-x C-l": "downcase-region",

      "M-q": "fill-paragraph",
